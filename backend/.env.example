# ── MongoDB Atlas ──────────────────────────────────────────────────
# Get from: Atlas → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/isamoh?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Frontend origin (CORS) ─────────────────────────────────────────
# Your deployed frontend URL — no trailing slash
CLIENT_URL=https://your-app.railway.app

# ── Email (Nodemailer) ─────────────────────────────────────────────
# Leave SMTP_USER blank to log emails to console only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# ── Shop Info ──────────────────────────────────────────────────────
SHOP_NAME=Isa Moh Mobile Shop
SHOP_EMAIL=isamohammedabere@gmail.com
SHOP_PHONE=+251 929 346 248
